# Imagen del Job keycloak-config (B5, T11.3): keycloak-config-cli con el realm y configurar-api.sh adentro.
# La base es Ubuntu y ya trae bash y curl; solo falta jq. Los valores salen de los secretos del Job, nunca de la imagen.
# docker build -f Dockerfile.config -t keycloak-config plataforma/keycloak
FROM adorsys/keycloak-config-cli:6.5.1-26.5.5
USER root
RUN apt-get update && apt-get install -y --no-install-recommends jq && rm -rf /var/lib/apt/lists/*
USER 65534
COPY --chmod=0755 aplicar-realm.sh configurar-api.sh /realm/
COPY realm-transporte.json perfil-usuario.json usuarios-semilla.json /realm/
ENV KC_CONFIG_EN_CONTENEDOR=1
ENTRYPOINT ["/realm/aplicar-realm.sh"]
