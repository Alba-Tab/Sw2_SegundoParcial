# Valores LOCALES de ejemplo para aplicar el realm (cp .env.example .env). En la nube salen de los
# secretos de Container Apps (T11.3) y nunca de este archivo.
KC_URL=http://localhost:8080
KC_ADMIN=admin
KC_ADMIN_CLAVE=admin
KC_CLAVE_SEMILLA=Clave123!
KC_SECRETO_GATEWAY=secreto-gateway
KC_SECRETO_ANALITICA=secreto-analitica
KC_SECRETO_MCP_SERVER=secreto-mcp-server
KC_SECRETO_AGENTE=secreto-agente
KC_SECRETO_VIAJES=secreto-viajes
KC_SECRETO_FINANZAS=secreto-finanzas
KC_SECRETO_FLOTA=secreto-flota
# D39: direct grant de demo-cli solo en local.
KC_DEMO_CLI_DIRECT_GRANT=true
# D27: 300 s (demo: 120). En local sin TLS, `none`; en la nube se deja `external`.
KC_ACCESS_TOKEN_SEG=300
KC_SSL_REQUIRED=none
# URLs de las apps (en la nube, las de Firebase Hosting).
# KC_URL_CC_TABLERO=http://localhost:4201
