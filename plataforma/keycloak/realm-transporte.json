{
  "realm": "transporte",
  "displayName": "Transporte de Carga",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "sslRequired": "$(env:KC_SSL_REQUIRED:-external)",
  "accessTokenLifespan": "$(env:KC_ACCESS_TOKEN_SEG:-300)",
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "adminPermissionsEnabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es"
  ],
  "defaultLocale": "es",
  "roles": {
    "realm": [
      {
        "name": "default-roles-transporte",
        "description": "Rol por defecto vacío (K3)",
        "composite": false
      },
      {
        "name": "chofer",
        "description": "Registra en ruta sus viajes",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access"
          ]
        }
      },
      {
        "name": "despachador",
        "description": "Viajes, entregas observadas, intervenciones y acciones del agente"
      },
      {
        "name": "jefe_flota",
        "description": "Unidades, mantenimiento y combustible"
      },
      {
        "name": "administracion",
        "description": "Cotizaciones, aprobación de crédito, facturas y pagos"
      },
      {
        "name": "gerente",
        "description": "Todo en lectura, tablero, voz y reportes"
      },
      {
        "name": "comercial",
        "description": "Portal en nombre de un cliente; registra clientes sin cuenta"
      },
      {
        "name": "cliente",
        "description": "Sus cotizaciones, servicios, viajes, POD y facturas"
      },
      {
        "name": "agente_lectura",
        "description": "Herramientas de lectura del MCP y proponer_accion"
      }
    ]
  },
  "groups": [
    {
      "name": "registro-portal",
      "path": "/registro-portal"
    }
  ],
  "defaultGroups": [
    "/registro-portal"
  ],
  "clientScopes": [
    {
      "name": "cliente-id",
      "description": "Claim clienteId desde el atributo del usuario (propuesta 7.3)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "clienteId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "clienteId",
            "claim.name": "clienteId",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aud-gateway",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "gateway",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aud-analitica",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-analitica",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "analitica",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aud-mcp-server",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-mcp-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mcp-server",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aud-viajes",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-viajes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "viajes",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aud-finanzas",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-finanzas",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "finanzas",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aud-flota",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-flota",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "flota",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
