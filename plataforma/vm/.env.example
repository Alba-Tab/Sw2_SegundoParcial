# Valores de EJEMPLO de la VM (B3). En la EC2 el .env lo arma cargar-secretos.sh desde /transporte/env/* de
# Parameter Store; nunca uses estos valores en la nube. Para la prueba en la Mac (B12): cp .env.example .env
COMPOSE_PROJECT_NAME=transporte-vm
DOMINIO=localhost
# Correo de ACME para Let's Encrypt en la nube; `internal` en la Mac.
CADDY_TLS=internal
AWS_REGION=us-east-1

VIAJES_IMAGEN=transporte/viajes:b12
OIDC_ISSUER=http://mac.local:8080/realms/transporte
CORS_ORIGENES=http://localhost:4201,http://localhost:4202,http://localhost:4203,http://localhost:4204,http://localhost:5173
S3_BUCKET=transporte-evidencias
KC_SECRETO_VIAJES=secreto-viajes
FCM_PROYECTO=

POSTGRES_ADMIN_CLAVE=postgres
CLAVE_VIAJES=viajes
CLAVE_TEMPORAL=temporal

# RabbitMQ: administrador y un usuario por servicio (los crea rabbitmq-usuarios con ../compose/iniciar).
RABBITMQ_ADMIN=admin
RABBITMQ_ADMIN_CLAVE=admin
RABBITMQ_CLAVE_VIAJES=viajes
RABBITMQ_CLAVE_FINANZAS=finanzas
RABBITMQ_CLAVE_FLOTA=flota
RABBITMQ_CLAVE_ANALITICA=analitica
RABBITMQ_CLAVE_N8N=n8n
RABBITMQ_CLAVE_SENSOR=sensor-sim
