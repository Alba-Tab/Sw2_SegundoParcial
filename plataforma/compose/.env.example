# Valores LOCALES de ejemplo (cp .env.example .env). En la nube cada valor sale de los secretos de su nube.
COMPOSE_PROJECT_NAME=transporte

# Nombre mDNS de la Mac (scutil --get LocalHostName + ".local"). El iPhone y los contenedores llegan a Keycloak por aquí,
# así el emisor (iss) del token es el mismo para todos.
MAC_LOCAL=mac.local

# PostgreSQL "AWS" (Viajes y Temporal) y "Azure" (Finanzas, Keycloak, n8n, Analítica). Un usuario por base.
POSTGRES_ADMIN_CLAVE=postgres
CLAVE_VIAJES=viajes
CLAVE_TEMPORAL=temporal
CLAVE_FINANZAS=finanzas
CLAVE_KEYCLOAK=keycloak
CLAVE_N8N=n8n
CLAVE_ANALITICA=analitica

# MongoDB (Flota), réplica rs0 de un nodo para las transacciones del Outbox.
MONGO_URI="mongodb://localhost:27017/flota?replicaSet=rs0&directConnection=true"

# RabbitMQ: administrador y un usuario por servicio.
RABBITMQ_ADMIN=admin
RABBITMQ_ADMIN_CLAVE=admin
RABBITMQ_CLAVE_VIAJES=viajes
RABBITMQ_CLAVE_FINANZAS=finanzas
RABBITMQ_CLAVE_FLOTA=flota
RABBITMQ_CLAVE_ANALITICA=analitica
RABBITMQ_CLAVE_N8N=n8n
RABBITMQ_CLAVE_SENSOR=sensor-sim

# DynamoDB Local y S3 local (RustFS, compatible con S3).
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local-secreto
AWS_REGION=us-east-1
S3_BUCKET=transporte-evidencias

# Keycloak (realm en ../keycloak). Mismas variables que plataforma/keycloak/.env.example.
KC_ADMIN=admin
KC_ADMIN_CLAVE=admin
KC_CLAVE_SEMILLA=Clave123!
KC_SECRETO_GATEWAY=secreto-gateway
KC_SECRETO_ANALITICA=secreto-analitica
KC_SECRETO_MCP_SERVER=secreto-mcp-server
KC_SECRETO_AGENTE=secreto-agente
KC_SECRETO_VIAJES=secreto-viajes
KC_SECRETO_FINANZAS=secreto-finanzas
KC_SECRETO_FLOTA=secreto-flota
KC_DEMO_CLI_DIRECT_GRANT=true
KC_ACCESS_TOKEN_SEG=300
KC_SSL_REQUIRED=none

# Finanzas (Laravel): php artisan key:generate --show (solo local; en la nube sale de un secreto).
FINANZAS_APP_KEY=

# n8n
N8N_CLAVE_CIFRADO=clave-local-de-n8n

# Servicios (los leen viajes, flota y finanzas; P10: si OIDC_ISSUER está vacío, los endpoints de negocio responden 503).
OIDC_ISSUER=http://mac.local:8080/realms/transporte
CORS_ORIGENES=http://localhost:4201,http://localhost:4202,http://localhost:4203,http://localhost:4204,http://localhost:5173
# Perfil trazas (D23): los servicios del compose exportan al collector si esto está definido.
# OTEL_SERVICIOS_ENDPOINT=http://otel-collector:4318
