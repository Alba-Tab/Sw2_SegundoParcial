# Se usa con --env-file .env.demo (además de .env) y el perfil demo: desvía conexiones por Toxiproxy (N9) para
# los fallos de guion-fallos.md. Sin secretos.
FINANZAS_DB_HOST=toxiproxy
FINANZAS_DB_PORT=25433
FINANZAS_AMQP_HOST=toxiproxy
FINANZAS_AMQP_PORT=25672
GATEWAY_FINANZAS_URL=http://toxiproxy:28103

# parametrosSaga de la demo (spec 003): 3 min de espera de aprobación y compensaciones cortas para FS8.
SAGA_ESPERA_APROBACION=PT3M
SAGA_COMPENSACION_SCHEDULE_TO_CLOSE=PT2M
SAGA_COMPENSACION_MAXIMO_INTENTOS=4
