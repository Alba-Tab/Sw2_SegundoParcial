{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transporte.local/contratos/eventos/analitica/AvisoClienteAprobado.v1.schema.json",
  "title": "AvisoClienteAprobado v1",
  "description": "El despachador aprobó un aviso propuesto por el agente (spec 014). n8n lo envía tal cual. Clave de enrutamiento: analitica.aviso-cliente-aprobado.v1. Consumen: n8n.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../sobre.schema.json"
    }
  ],
  "properties": {
    "tipo": {
      "const": "AvisoClienteAprobado"
    },
    "version": {
      "const": 1
    },
    "productor": {
      "const": "analitica"
    },
    "datos": {
      "type": "object",
      "required": [
        "accionId",
        "clienteId",
        "destinatario",
        "asunto",
        "mensaje",
        "aprobadaPor",
        "enlacePortal"
      ],
      "additionalProperties": false,
      "properties": {
        "accionId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "clienteId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "viajeId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "destinatario": {
          "type": "object",
          "required": [
            "nombre",
            "correo"
          ],
          "additionalProperties": false,
          "properties": {
            "nombre": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120
            },
            "correo": {
              "type": "string",
              "format": "email"
            }
          }
        },
        "asunto": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "mensaje": {
          "type": "string",
          "minLength": 3,
          "maxLength": 4000
        },
        "aprobadaPor": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Sub"
        },
        "enlacePortal": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "examples": [
    {
      "id": "01933d18-0000-7000-8000-000000000018",
      "tipo": "AvisoClienteAprobado",
      "version": 1,
      "ocurridoEn": "2026-11-03T15:20:01Z",
      "correlationId": "01933b6e-4c2a-7d10-9a3e-5f1c2b7a8dff",
      "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "productor": "analitica",
      "datos": {
        "accionId": "01933c50-0000-7000-8000-00000000aa01",
        "clienteId": "01933b5a-1f00-7a20-8b11-0c2d3e4f5a01",
        "viajeId": "01933b6f-0000-7d10-9a3e-5f1c2b7a8d12",
        "destinatario": {
          "nombre": "Agroexport SRL",
          "correo": "cobranzas@agroexport.example"
        },
        "asunto": "Su viaje a La Paz llegará con retraso",
        "mensaje": "Hay un bloqueo en Yapacaní; estimamos la entrega mañana a las 10:00.",
        "aprobadaPor": "8b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6e",
        "enlacePortal": "https://portal.transporte.example/servicios/01933b6f-0000-7d10-9a3e-5f1c2b7a8d11"
      }
    }
  ]
}
