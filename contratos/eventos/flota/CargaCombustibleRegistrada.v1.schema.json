    },
    "version": {
      "const": 1
    },
    "productor": {
      "const": "flota"
    },
    "datos": {
      "type": "object",
      "required": [
        "cargaId",
        "opId",
        "tractoId",
        "placa",
        "choferId",
        "litros",
        "monto",
        "kilometraje",
        "registradaEn"
      ],
      "additionalProperties": false,
      "properties": {
        "cargaId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "opId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "tractoId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "placa": {
          "type": "string",
          "pattern": "^[0-9]{3,4}[A-Z]{3}$"
        },
        "choferId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "viajeId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "litros": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1500
        },
        "monto": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Monto"
        },
        "kilometraje": {
          "type": "number",
          "minimum": 0
        },
        "registradaEn": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Instante"
        },
        "posicion": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Coordenadas"
        }
      }
    }
  },
