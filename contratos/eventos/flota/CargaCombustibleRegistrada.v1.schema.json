{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transporte.local/contratos/eventos/flota/CargaCombustibleRegistrada.v1.schema.json",
  "title": "CargaCombustibleRegistrada v1",
  "description": "Carga de combustible registrada por el chofer (spec 009); idempotente por opId. Clave de enrutamiento: flota.carga-combustible-registrada.v1. Consumen: analitica.",
  "type": "object",
  "allOf": [
