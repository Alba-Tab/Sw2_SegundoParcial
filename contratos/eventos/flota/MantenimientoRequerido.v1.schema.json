{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transporte.local/contratos/eventos/flota/MantenimientoRequerido.v1.schema.json",
  "title": "MantenimientoRequerido v1",
  "description": "Al liberar una unidad, Flota detectó kilometraje o documentos por vencer (spec 010, D07). La unidad queda en MANTENIMIENTO_PENDIENTE. Clave de enrutamiento: flota.mantenimiento-requerido.v1. Consumen: analitica.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../sobre.schema.json"
    }
  ],
  "properties": {
    "tipo": {
      "const": "MantenimientoRequerido"
    },
    "version": {
      "const": 1
    },
    "productor": {
      "const": "flota"
    },
    "datos": {
      "type": "object",
      "required": [
        "unidadId",
        "tipoUnidad",
        "placa",
        "motivos",
        "kmDesdeUltimo"
      ],
      "additionalProperties": false,
      "properties": {
        "unidadId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "tipoUnidad": {
          "type": "string",
          "enum": [
            "TRACTO",
            "REMOLQUE"
          ]
        },
        "placa": {
          "type": "string",
          "pattern": "^[0-9]{3,4}[A-Z]{3}$"
        },
        "motivos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "KILOMETRAJE",
              "SOAT",
              "INSPECCION"
            ]
          }
        },
        "kmDesdeUltimo": {
          "type": "number",
          "minimum": 0
        },
        "documentoVenceEl": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Fecha"
        }
      }
    }
  },
  "examples": [
    {
      "id": "01933d17-0000-7000-8000-000000000017",
      "tipo": "MantenimientoRequerido",
      "version": 1,
      "ocurridoEn": "2026-11-03T15:20:01Z",
      "correlationId": "01933b6e-4c2a-7d10-9a3e-5f1c2b7a8dff",
      "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "productor": "flota",
      "datos": {
        "unidadId": "01933900-0000-7000-8000-00000000a101",
        "tipoUnidad": "TRACTO",
        "placa": "4521KTR",
        "motivos": [
          "KILOMETRAJE"
        ],
        "kmDesdeUltimo": 10070
      }
    }
  ]
}
