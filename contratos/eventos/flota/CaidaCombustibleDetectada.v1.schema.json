    "version": {
      "const": 1
    },
    "productor": {
      "const": "flota"
    },
    "datos": {
      "type": "object",
      "required": [
        "deteccionId",
        "tractoId",
        "placa",
        "nivelAnteriorPct",
        "nivelActualPct",
        "caidaPct",
        "ventanaMinutos",
        "velocidadKmh",
        "detectadaEn"
