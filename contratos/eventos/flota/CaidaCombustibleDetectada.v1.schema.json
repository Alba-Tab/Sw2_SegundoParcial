{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transporte.local/contratos/eventos/flota/CaidaCombustibleDetectada.v1.schema.json",
  "title": "CaidaCombustibleDetectada v1",
  "description": "El nivel del tanque cayó 8 % o más en 10 min con el camión detenido (D08): posible robo. Clave de enrutamiento: flota.caida-combustible-detectada.v1. Consumen: analitica.",
  "type": "object",
