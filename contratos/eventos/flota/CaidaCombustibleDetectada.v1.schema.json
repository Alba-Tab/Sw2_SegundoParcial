          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "tractoId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "placa": {
          "type": "string",
          "pattern": "^[0-9]{3,4}[A-Z]{3}$"
        },
        "viajeId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "nivelAnteriorPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "nivelActualPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "caidaPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "ventanaMinutos": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "velocidadKmh": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "detectadaEn": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Instante"
        }
      }
    }
  },
