{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transporte.local/contratos/eventos/viajes/ViajeRequiereIntervencion.v1.schema.json",
  "title": "ViajeRequiereIntervencion v1",
  "description": "Una compensación de la saga se agotó (spec 011). Analítica crea la alerta para el despachador. Clave de enrutamiento: viajes.viaje-requiere-intervencion.v1. Consumen: analitica.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../sobre.schema.json"
    }
  ],
  "properties": {
