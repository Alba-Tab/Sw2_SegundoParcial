          "type": "string",
          "enum": [
            "Flota.liberarReserva",
            "Finanzas.liberarCredito",
            "Viajes.cancelarViaje"
          ]
        },
        "error": {
          "type": "object",
          "required": [
            "codigo",
            "mensaje"
          ],
          "additionalProperties": false,
          "properties": {
            "codigo": {
              "$ref": "../../comun/tipos.schema.json#/$defs/CodigoError"
            },
            "mensaje": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "intentos": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "examples": [
