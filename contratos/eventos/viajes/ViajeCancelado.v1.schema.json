{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transporte.local/contratos/eventos/viajes/ViajeCancelado.v1.schema.json",
  "title": "ViajeCancelado v1",
  "description": "Viaje cancelado por el usuario (spec 004) o por la saga al compensar o al resolver una intervención (specs 003 y 011). Los consumidores liberan crédito y unidad de forma idempotente. Clave de enrutamiento: viajes.viaje-cancelado.v1. Consumen: finanzas, flota, analitica.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../sobre.schema.json"
    }
  ],
  "properties": {
    "tipo": {
      "const": "ViajeCancelado"
    },
    "version": {
      "const": 1
    },
    "productor": {
      "const": "viajes"
    },
    "datos": {
      "type": "object",
      "required": [
        "servicioId",
        "viajeId",
        "clienteId",
        "motivo",
        "origen",
        "estadoAnterior"
      ],
      "additionalProperties": false,
      "properties": {
        "servicioId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "viajeId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "clienteId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "motivo": {
          "$ref": "../../comun/tipos.schema.json#/$defs/CodigoError"
        },
        "detalle": {
          "type": "string",
          "maxLength": 600
        },
        "origen": {
          "$ref": "../../comun/tipos.schema.json#/$defs/OrigenCancelacion"
        },
        "canceladoPor": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Sub"
        },
        "estadoAnterior": {
          "$ref": "../../comun/tipos.schema.json#/$defs/EstadoViaje"
        },
        "choferUsuarioSub": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Sub"
        }
      },
      "if": {
        "properties": {
          "origen": {
            "const": "USUARIO"
          }
        }
      },
      "then": {
        "required": [
          "canceladoPor"
        ]
      }
    }
  },
