{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transporte.local/contratos/eventos/viajes/ViajeIniciado.v1.schema.json",
  "title": "ViajeIniciado v1",
  "description": "El chofer registró la salida (spec 005). Flota pasa la unidad a EN_VIAJE (D20); Analítica guarda la hora real de salida. Clave de enrutamiento: viajes.viaje-iniciado.v1. Consumen: flota, analitica.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../sobre.schema.json"
    }
  ],
  "properties": {
    "tipo": {
      "const": "ViajeIniciado"
    },
    "version": {
      "const": 1
    },
    "productor": {
      "const": "viajes"
    },
    "datos": {
      "type": "object",
      "required": [
        "viajeId",
        "servicioId",
        "choferId",
        "tractoId",
        "remolqueId",
        "placa",
        "iniciadoEn"
      ],
      "additionalProperties": false,
      "properties": {
        "viajeId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "servicioId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "choferId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "tractoId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "remolqueId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "placa": {
          "type": "string",
          "pattern": "^[0-9]{3,4}[A-Z]{3}$"
        },
        "iniciadoEn": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Instante"
        },
        "posicion": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Coordenadas"
        }
      }
    }
  },
  "examples": [
    {
      "id": "01933d05-0000-7000-8000-000000000005",
      "tipo": "ViajeIniciado",
      "version": 1,
      "ocurridoEn": "2026-11-03T15:20:01Z",
