{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transporte.local/contratos/eventos/finanzas/FacturaEmitida.v1.schema.json",
  "title": "FacturaEmitida v1",
  "description": "Factura interna emitida por una entrega confirmada (spec 006). Viajes cierra el viaje; n8n avisa al cliente con los datos que ya trae el evento; Analítica actualiza cuentas por cobrar. Clave de enrutamiento: finanzas.factura-emitida.v1. Consumen: viajes, n8n, analitica.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../sobre.schema.json"
    }
  ],
  "properties": {
    "tipo": {
      "const": "FacturaEmitida"
    },
    "version": {
      "const": 1
    },
    "productor": {
      "const": "finanzas"
    },
    "datos": {
      "type": "object",
      "required": [
        "facturaId",
        "numero",
        "viajeId",
        "servicioId",
        "clienteId",
        "monto",
        "emitidaEl",
        "venceEl",
        "cliente",
        "enlacePortal"
      ],
      "additionalProperties": false,
      "properties": {
        "facturaId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "numero": {
          "type": "string",
          "pattern": "^FAC-[0-9]{6}$"
        },
        "viajeId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "servicioId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "clienteId": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Uuid"
        },
        "monto": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Monto"
        },
        "emitidaEl": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Fecha"
        },
        "venceEl": {
          "$ref": "../../comun/tipos.schema.json#/$defs/Fecha"
        },
        "cliente": {
          "type": "object",
          "required": [
            "razonSocial",
            "correo"
          ],
          "additionalProperties": false,
          "properties": {
            "razonSocial": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120
            },
            "correo": {
              "type": "string",
              "format": "email"
            }
          }
        },
        "enlacePortal": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "examples": [
    {
      "id": "01933d13-0000-7000-8000-000000000013",
      "tipo": "FacturaEmitida",
      "version": 1,
      "ocurridoEn": "2026-11-03T15:20:01Z",
      "correlationId": "01933b6e-4c2a-7d10-9a3e-5f1c2b7a8dff",
      "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "productor": "finanzas",
      "datos": {
        "facturaId": "01933c20-0000-7000-8000-00000000f001",
        "numero": "FAC-000123",
        "viajeId": "01933b6e-4c2a-7d10-9a3e-5f1c2b7a8d02",
        "servicioId": "01933b6e-4c2a-7d10-9a3e-5f1c2b7a8d01",
        "clienteId": "01933b5a-1f00-7a20-8b11-0c2d3e4f5a01",
        "monto": {
          "monto": "2800.00",
          "moneda": "BOB"
        },
        "emitidaEl": "2026-11-03",
        "venceEl": "2026-12-03",
        "cliente": {
          "razonSocial": "Agroexport SRL",
          "correo": "cobranzas@agroexport.example"
        },
        "enlacePortal": "https://portal.transporte.example/facturas/01933c20-0000-7000-8000-00000000f001"
      }
    }
  ]
}
