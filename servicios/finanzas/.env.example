# Finanzas en local. En docker compose las variables las pone el compose; en la nube, los secretos de Container Apps.
APP_NAME=finanzas
APP_ENV=local
APP_KEY=
APP_DEBUG=false
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=finanzas
DB_USERNAME=finanzas
DB_PASSWORD=finanzas

AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USUARIO=finanzas
AMQP_CLAVE=finanzas
TEMPORAL_ADDRESS=localhost:7233

# P10: vacío = los endpoints de negocio responden 503 DEPENDENCIA_NO_DISPONIBLE.
OIDC_ISSUER=http://mac.local:8080/realms/transporte
CORS_ORIGENES=http://localhost:4201,http://localhost:4202,http://localhost:4203,http://localhost:4204,http://localhost:5173

# Sin sesiones ni colas de Laravel: Finanzas es una API sin estado.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Perfil trazas (D23): la extensión opentelemetry instrumenta Laravel solo si se activa aquí.
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_SERVICE_NAME=finanzas
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
