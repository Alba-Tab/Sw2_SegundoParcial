{
  "name": "gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Gateway GraphQL del Centro de Control (BFF, spec 016): compone Viajes, Flota, Finanzas y Analítica con el token intercambiado",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "tipos": "tsc --noEmit -p tsconfig.json",
    "formato": "prettier --check src test",
    "test": "jest --runInBand",
    "verificar": "npm run tipos && npm run formato && npm test"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@graphql-tools/utils": "12.0.0",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.8",
    "@transporte/intercambio-token": "file:../../libs/intercambio-token",
    "dataloader": "2.2.3",
    "graphql": "16.11.0",
    "graphql-query-complexity": "2.0.0",
    "graphql-ws": "6.4.1",
    "jose": "6.2.14",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.2",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
