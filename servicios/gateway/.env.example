# Gateway en local fuera de docker (npm run build && npm start). En docker compose las pone el compose.
PORT=8105
OIDC_ISSUER=http://mac.local:8080/realms/transporte
# Secreto del cliente confidencial `gateway` de Keycloak: el valor real vive en plataforma/keycloak/.env (no se versiona).
OIDC_CLIENTE_SECRETO=cambiar
VIAJES_URL=http://localhost:8101
FLOTA_URL=http://localhost:8102
FINANZAS_URL=http://localhost:8103
ANALITICA_URL=http://localhost:8104
GATEWAY_URL=http://localhost:8105
# Igual en todas las instancias (D21): firma los enlaces de descarga de Excel.
EXPORTACION_HMAC_SECRETO=cambiar
CORS_ORIGENES=http://localhost:4201,http://localhost:4202,http://localhost:4203,http://localhost:4204,http://localhost:5173
# Introspección de GraphQL: apagada por defecto y en la nube (spec 016). true solo para explorar el esquema en local.
GRAPHQL_INTROSPECCION=false
# Ruta del esquema (por defecto contratos/graphql/centro-control.graphql del repo).
# ESQUEMA_GRAPHQL=../../contratos/graphql/centro-control.graphql
