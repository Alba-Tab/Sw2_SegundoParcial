{
  "name": "mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor MCP con herramientas cerradas para el agente y la voz (spec 014): especificación 2026-07-28, sin sesiones",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "tipos": "tsc --noEmit -p tsconfig.json",
    "formato": "prettier --check src test",
    "test": "jest --runInBand",
    "verificar": "npm run tipos && npm run formato && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@transporte/intercambio-token": "file:../../libs/intercambio-token",
    "jose": "6.2.14",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
