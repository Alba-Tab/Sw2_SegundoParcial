{
  "name": "flota",
  "version": "0.0.1",
  "private": true,
  "description": "Flota: unidades, choferes, reservas, combustible y mantenimiento (NestJS, Clean)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest --selectProjects unitarias",
    "test:integracion": "jest --selectProjects integracion --runInBand",
    "test:todo": "jest --runInBand",
    "capas": "depcruise src --config .dependency-cruiser.cjs",
    "tipos": "tsc --noEmit -p tsconfig.json",
    "verificar": "npm run tipos && npm run capas && npm run formato && npm run test:todo",
    "formato": "prettier --check src test",
    "generar:contratos": "orval --config orval.config.cjs && prettier --write src/infraestructura/http/contrato --log-level warn",
    "generar:contratos:verificar": "npm run generar:contratos && test -z \"$(git status --porcelain -- src/infraestructura/http/contrato)\" || (echo \"El código generado no coincide con contratos/openapi/flota.yaml: corre npm run generar:contratos y súbelo\" && git status --porcelain -- src/infraestructura/http/contrato && exit 1)"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.8",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@temporalio/activity": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "amqplib": "0.10.9",
    "decimal.js": "10.6.0",
    "jose": "6.2.14",
    "mongoose": "8.24.7",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@testcontainers/rabbitmq": "11.14.0",
    "@types/amqplib": "0.10.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "dependency-cruiser": "18.7.0",
    "jest": "30.5.2",
    "orval": "8.45.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "testcontainers": "11.14.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
