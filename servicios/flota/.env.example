# Flota en local fuera de docker (npm run build && npm start / npm run start:worker). En docker compose las pone el compose.
PORT=8102
MONGO_URI="mongodb://localhost:27017/flota?replicaSet=rs0&directConnection=true"
AMQP_URL=amqp://flota:flota@localhost:5672
# P10: vacío = los endpoints de negocio responden 503 DEPENDENCIA_NO_DISPONIBLE.
OIDC_ISSUER=http://mac.local:8080/realms/transporte
CORS_ORIGENES=http://localhost:4201,http://localhost:4202,http://localhost:4203,http://localhost:4204,http://localhost:5173
OUTBOX_INTERVALO_MS=1000
# Perfil trazas (D23): exporta solo si está definido.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_WORKER=true
