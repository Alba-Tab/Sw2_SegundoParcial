{
  "name": "centro-control",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generar": "graphql-codegen --config codegen.ts",
    "generar:verificar": "npm run generar && test -z \"$(git status --porcelain -- 'projects/*/src/*/graphql/generado.ts')\" || (echo 'El código generado no coincide con el esquema: corre npm run generar' && exit 1)",
    "formato": "prettier --check \"projects/**/*.{ts,html,css,graphql}\" codegen.ts",
    "construir": "ng build cc-tablero && ng build cc-operaciones && ng build cc-flota && ng build cc-finanzas",
    "probar": "ng test ui-comun --watch=false",
    "verificar": "npm run formato && npm run probar && npm run construir",
    "modelos": "sh scripts/descargar-whisper.sh"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@apollo/client": "4.3.5",
    "@huggingface/transformers": "4.3.2",
    "@transporte/design-tokens": "file:../../libs/design-tokens",
    "apollo-angular": "14.2.0",
    "graphql": "16.11.0",
    "graphql-ws": "6.4.1",
    "leaflet": "1.9.4",
    "oidc-client-ts": "3.5.0",
    "rxjs": "~7.8.0",
    "tesseract.js": "7.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-apollo-angular": "5.0.1",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@types/leaflet": "1.9.22",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "Centro de Control (spec 016): 4 apps Angular independientes (cc-tablero, cc-operaciones, cc-flota, cc-finanzas) y la librería ui-comun"
}
