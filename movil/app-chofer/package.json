{
  "name": "app-chofer",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "App del chofer (React Native + Expo): viaje sin conexión, cola local y sincronización (spec 005)",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "tipos": "tsc --noEmit",
    "lint": "eslint .",
    "formato": "prettier --check src",
    "test": "vitest run",
    "verificar": "npm run tipos && npm run lint && npm run formato && npm test",
    "generar:contratos": "orval --config orval.config.ts && prettier --write src/datos/api/generado --log-level warn",
    "generar:contratos:verificar": "npm run generar:contratos && test -z \"$(git status --porcelain -- src/datos/api/generado)\" || (echo 'src/datos/api/generado no coincide con contratos/openapi: corre npm run generar:contratos' && git status --porcelain -- src/datos/api/generado && exit 1)",
    "generar:migraciones": "drizzle-kit generate"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "@transporte/design-tokens": "file:../../libs/design-tokens",
    "babel-preset-expo": "~57.0.0",
    "drizzle-orm": "0.45.4",
    "expo": "57.0.31",
    "expo-auth-session": "~57.0.16",
    "expo-background-task": "~57.0.21",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-location": "~57.0.22",
    "expo-network": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "5.15.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.2.14",
    "babel-plugin-inline-import": "3.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "orval": "8.45.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
